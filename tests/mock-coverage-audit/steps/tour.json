   "expr": "(() => { const btns = Array.from(document.querySelectorAll('button')); const target = btns.find(b => { const t = b.innerText.trim(); return t.includes('菜单授权') || t.includes('菜單授權') || t.includes('菜单'); }); if (!target) return JSON.stringify({err: 'btn not found', sample: btns.map(b => b.innerText.trim()).filter(t => t).slice(0, 40)}); target.click(); return JSON.stringify({ok: true, clicked: target.innerText.trim()}); })()"
  },
  {"kind": "sleep", "ms": 3500},
