  },
  {"kind": "sleep", "ms": 1500},
  {"kind": "eval", "note": "raw fetch /auth/error (expect custom code)",
   "expr": "fetch('/proxy-default/auth/error?code=8888&msg=test', {headers: {Authorization: 'Bearer ' + (localStorage.getItem('SOY_token') || '')}}).then(r => r.text()).then(t => 'AUTH-ERROR:' + t.slice(0, 1500))"
  },
  {"kind": "sleep", "ms": 1500},
  {"kind": "eval", "note": "raw fetch /auth/refreshToken (POST)",
   "expr": "fetch('/proxy-default/auth/refreshToken', {method: 'POST', headers: {'Content-Type': 'application/json', Authorization: 'Bearer ' + (localStorage.getItem('SOY_token') || '')}, body: JSON.stringify({refreshToken: localStorage.getItem('SOY_refreshToken') || ''})}).then(r => r.text()).then(t => 'REFRESH-TOKEN:' + t.slice(0, 1500))"
  },
  {"kind": "sleep", "ms": 2000},
  {"kind": "log", "msg": "=== T13: list all SOY_ localStorage keys ==="},
  {"kind": "eval", "note": "list local storage SOY_ keys",
   "expr": "JSON.stringify(Object.keys(localStorage).filter(k => k.startsWith('SOY_')).map(k => ({k, v: (localStorage.getItem(k) || '').slice(0, 80)})))"
  }
