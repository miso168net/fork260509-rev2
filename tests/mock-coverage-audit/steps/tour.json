  {"kind": "log", "msg": "=== T6: close modal ==="},
  {"kind": "eval", "expr": "document.body.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape', keyCode: 27, bubbles: true})); 'esc-sent'"},
  {"kind": "sleep", "ms": 1500},

