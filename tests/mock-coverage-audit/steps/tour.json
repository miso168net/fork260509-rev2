[
  {"kind": "log", "msg": "=== T1: navigate /manage/user — user list ==="},
  {"kind": "navigate", "url": "http://127.0.0.1:9527/manage/user", "waitMs": 3000},
  {"kind": "screenshot", "file": "./screenshots/shot-10-user-list.png"},
  {"kind": "sleep", "ms": 2000},

  {"kind": "log", "msg": "=== T2: click 新增 to open user drawer ==="},
  {"kind": "eval", "note": "find and click 新增 button on user page",
   "expr": "(() => { const btns = Array.from(document.querySelectorAll('button')); const target = btns.find(b => { const t = b.innerText.trim(); return t === '新增' || t === '新增用户' || t.includes('新增'); }); if (!target) return JSON.stringify({err: 'btn not found', titles: btns.map(b => b.innerText.trim()).filter(t => t).slice(0, 30)}); target.click(); return JSON.stringify({ok: true, clicked: target.innerText.trim()}); })()"
  },
  {"kind": "sleep", "ms": 3000},
  {"kind": "screenshot", "file": "./screenshots/shot-11-user-drawer.png"},
  {"kind": "eval", "note": "check drawer state",
   "expr": "JSON.stringify({drawer: document.querySelector('.n-drawer') ? 'open' : 'none', modal: document.querySelector('.n-modal') ? 'open' : 'none'})"
  },

  {"kind": "log", "msg": "=== T3: close drawer (ESC) ==="},
  {"kind": "eval", "note": "press ESC to close any modal/drawer",
   "expr": "document.body.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape', keyCode: 27, bubbles: true})); 'esc-sent'"
  },
  {"kind": "sleep", "ms": 1500},

  {"kind": "log", "msg": "=== T4: navigate /manage/role — role list ==="},
  {"kind": "navigate", "url": "http://127.0.0.1:9527/manage/role", "waitMs": 3000},
  {"kind": "screenshot", "file": "./screenshots/shot-12-role-list.png"},
  {"kind": "sleep", "ms": 2000},

  {"kind": "log", "msg": "=== T5: try open 菜單授權 modal (table row action button) ==="},
