# PostgreSQL 連線字串,供 rust-api 讀取(Phase 2 wired)。
# 跑 bash deploy/generate-secrets.sh 自動生成(處理 dual-write)。
# 手動 fallback(讀既有 leaf 維持 dual-write,切勿另生隨機值): echo "postgres://soybean:$(cat deploy/secrets/postgres_password.txt)@postgres:5432/soybean_admin_rust" > deploy/secrets/database_url.txt
# dual-write: 內嵌 password 段須 ≡ postgres_password.txt(腳本自動保證)
postgres://soybean:CHANGE_ME@postgres:5432/soybean_admin_rust
