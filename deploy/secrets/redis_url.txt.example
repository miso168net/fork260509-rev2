# Redis 連線字串,供 rust-api 讀取(Phase 2 wired)。
# 跑 bash deploy/generate-secrets.sh 自動生成(處理 dual-write)。
# 手動 fallback(讀既有 leaf 維持 dual-write,切勿另生隨機值): echo "redis://:$(cat deploy/secrets/redis_password.txt)@redis-stack:6379" > deploy/secrets/redis_url.txt
# dual-write: 內嵌 password 段須 ≡ redis_password.txt(腳本自動保證)
redis://:CHANGE_ME@redis-stack:6379
