# Cleanup job 專用 PostgreSQL 連線字串(供定期清理任務使用)。
# 跑 bash deploy/generate-secrets.sh 自動生成(處理 dual-write)。
# 手動 fallback: echo "postgres://soybean:$(docker run --rm alpine/openssl rand -hex 24)@postgres:5432/soybean_admin_rust" > deploy/secrets/cleanup_database_url.txt
# dual-write: 內嵌 password 段須 ≡ postgres_password.txt(腳本自動保證)
# 最小權限 cleanup role 留 Phase 5(暫與 database_url 同值)
postgres://soybean:CHANGE_ME@postgres:5432/soybean_admin_rust
